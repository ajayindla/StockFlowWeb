@rendermode InteractiveServer
@using StockFlowWeb.Shared.Services
@using StockFlowWeb.Shared.Models
@inject DatabaseService Db
@inject NavigationManager Nav

<nav class="topnav">
    <a class="brand" href="/">
        <svg width="52" height="52" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Cube top face -->
            <polygon points="18,4 30,11 18,18 6,11" fill="#cc0000" />
            <!-- Cube left face -->
            <polygon points="6,11 18,18 18,30 6,23" fill="#880000" />
            <!-- Cube right face -->
            <polygon points="30,11 18,18 18,30 30,23" fill="#111111" />
            <!-- Green bars → now red/dark -->
            <rect x="11" y="21" width="3" height="7" rx="1" fill="#111111" />
            <rect x="15" y="18" width="3" height="10" rx="1" fill="#cc0000" />
            <rect x="19" y="15" width="3" height="13" rx="1" fill="#880000" />
            <rect x="23" y="19" width="3" height="9" rx="1" fill="#111111" />
        </svg>
        <div>
            <div class="brand-name">StockFlow</div>
            <div class="brand-sub">Inventory Manager</div>
        </div>
    </a>

    <div class="nav-links">
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
        <NavLink class="nav-link" href="/inventory">Inventory</NavLink>
        <NavLink class="nav-link" href="/purchase-orders">Orders</NavLink>
        <NavLink class="nav-link" href="/suppliers">Suppliers</NavLink>
        <NavLink class="nav-link" href="/charts">Analytics</NavLink>
    </div>

    <div class="global-search" @onfocusout="DelayClose">
        <div class="global-search-input-wrap">
            <input type="text"
                   placeholder="Search products, SKU..."
                   @bind="_query"
                   @bind:event="oninput"
                   @bind:after="OnSearch"
                   @onfocus="OnFocus" />
            <button class="search-btn" @onclick="GoToInventory">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </button>
        </div>
    </div>
</nav>

@if (_showResults)
{
    <div class="search-overlay" @onclick="ClearSearch"></div>
    <div class="search-dropdown-portal">
        @if (_showResults)
        {
            <div class="search-overlay" @onclick="ClearSearch"></div>
            <div style="position:fixed;top:72px;right:20px;width:380px;background:#ffffff;border:1px solid #ddd;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,0.4);z-index:999999;overflow:hidden;">
                @if (_results.Any())
                {
                    @foreach (var p in _results.Take(6))
                    {
                        <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;cursor:pointer;border-bottom:1px solid #f0f0f0;background:#ffffff;"
                             @onclick="() => GoToProduct(p)"
                             @onmouseenter="() => _hoveredId = p.Id"
                             @onmouseleave="() => _hoveredId = 0">
                            <div style="width:40px;height:40px;background:#f5f5f5;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">
                                @GetCategoryIcon(p.CategoryId)
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:14px;font-weight:500;color:#111111;margin-bottom:2px;">@p.Name</div>
                                <div style="font-size:12px;color:#888888;">@p.SKU · @p.Quantity in stock</div>
                            </div>
                            <span class="badge @GetBadge(p)">@p.StockStatus</span>
                        </div>
                    }
                    <div style="padding:12px 16px;font-size:13px;color:#dc2626;cursor:pointer;text-align:center;background:#ffffff;font-weight:500;border-top:1px solid #f0f0f0;"
                         @onclick="GoToInventory">
                        🔍 View all @_results.Count results in Inventory
                    </div>
                }
                else
                {
                    <div style="padding:24px;font-size:14px;color:#888;text-align:center;background:#ffffff;">
                        No products found for "@_query"
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private string _query = "";
    private bool _showResults = false;
    private List<Product> _results = new();
    private List<Product> _allProducts = new();
    private Dictionary<int, string> _categoryIcons = new();
    private int _hoveredId = 0;

    protected override async Task OnInitializedAsync()
    {
        _allProducts = await Db.GetProductsAsync();
        var cats = await Db.GetCategoriesAsync();
        _categoryIcons = cats.ToDictionary(c => c.Id, c => c.Icon);
    }

    private async Task OnSearch()
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            _results = new();
            _showResults = false;
            return;
        }
        _results = await Db.SearchProductsAsync(_query);
        _showResults = true;
    }

    private void OnFocus()
    {
        if (!string.IsNullOrEmpty(_query) && _results.Any())
            _showResults = true;
    }

    private async Task DelayClose()
    {
        await Task.Delay(200);
        _showResults = false;
    }

    private void ClearSearch()
    {
        _query = "";
        _results = new();
        _showResults = false;
    }

    private void GoToProduct(Product p)
    {
        _showResults = false;
        _query = "";
        Nav.NavigateTo($"/product/edit/{p.Id}");
    }

    private void GoToInventory()
    {
        _showResults = false;
        Nav.NavigateTo("/inventory");
    }

    private string GetCategoryIcon(int categoryId) =>
        _categoryIcons.TryGetValue(categoryId, out var icon) ? icon : "📦";

    private string GetBadge(Product p) => p.StockStatus switch
    {
        "Out of Stock" => "badge-red",
        "Low Stock" => "badge-warn",
        _ => "badge-green"
    };
}