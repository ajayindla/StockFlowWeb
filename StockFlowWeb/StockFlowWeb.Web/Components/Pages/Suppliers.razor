@page "/suppliers"
@rendermode InteractiveServer
@inject DatabaseService Db

<div class="page-wrap">
    <div class="page-header">
        <div>
            <div class="page-eyebrow">SUPPLY CHAIN</div>
            <div class="page-title">Suppliers</div>
        </div>
        <button class="btn btn-primary" @onclick='() => _showForm = !_showForm'>+ Add</button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert-danger">@_error</div>
    }

    @if (_showForm)
    {
        <div class="form-card" style="margin-bottom:16px">
            <div class="form-card-header">New Supplier</div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" @bind="_name" placeholder="Supplier name" />
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" @bind="_email" placeholder="contact@example.com" />
                </div>
                <div class="form-group">
                    <label>Phone</label>
                    <input type="text" @bind="_phone" placeholder="555-0100" />
                </div>
                <div class="form-group">
                    <label>Address</label>
                    <input type="text" @bind="_address" placeholder="123 Main St" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveAsync">Save Supplier</button>
                <button class="btn btn-outline" @onclick='() => _showForm = false'>Cancel</button>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (!_suppliers.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">🏭</div>
            <div class="empty-title">No suppliers yet</div>
            <div class="empty-sub">Add your first supplier to get started</div>
        </div>
    }
    else
    {
        @foreach (var s in _suppliers)
        {
            <div class="supplier-card">
                <div>
                    <div class="supplier-name">@s.Name</div>
                    <div class="supplier-detail">
                        <span>✉️</span>
                        <span>@s.ContactEmail</span>
                    </div>
                    <div class="supplier-detail">
                        <span>📞</span>
                        <span>@s.Phone</span>
                    </div>
                </div>
                <button class="btn-icon danger" @onclick="() => DeleteAsync(s)">🗑</button>
            </div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private bool _showForm = false;
    private string _error = "";
    private string _name = "", _email = "", _phone = "", _address = "";
    private List<Supplier> _suppliers = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _suppliers = await Db.GetSuppliersAsync();
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _error = "";
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Supplier name is required."; return; }
        await Db.SaveSupplierAsync(new Supplier
        {
            Name = _name.Trim(),
            ContactEmail = _email.Trim(),
            Phone = _phone.Trim(),
            Address = _address.Trim()
        });
        _name = _email = _phone = _address = "";
        _showForm = false;
        await LoadAsync();
    }

    private async Task DeleteAsync(Supplier s)
    {
        await Db.DeleteSupplierAsync(s);
        await LoadAsync();
    }
}