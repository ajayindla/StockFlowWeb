@page "/add-order"
@rendermode InteractiveServer
@inject DatabaseService Db
@inject NavigationManager Nav

<div class="page">
    <h2>New Purchase Order</h2>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert-danger">@_error</div>
    }

    <div class="form">
        <div class="form-group">
            <label>Supplier</label>
            <select @bind="_supplierId">
                <option value="0">-- Select Supplier --</option>
                @foreach (var s in _suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>Notes</label>
            <input type="text" @bind="_notes" placeholder="Optional notes..." />
        </div>
    </div>

    <!-- Add Item -->
    <h3>Add Items</h3>
    <div class="form">
        <div class="form-group">
            <label>Product</label>
            <select @bind="_selectedProductId">
                <option value="0">-- Select Product --</option>
                @foreach (var p in _products)
                {
                    <option value="@p.Id">@p.Name (@p.SKU)</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>Quantity</label>
            <input type="number" @bind="_qty" min="1" />
        </div>
        <div class="form-group">
            <label>Unit Cost</label>
            <input type="number" @bind="_unitCost" min="0" step="0.01" />
        </div>
        <button class="btn-secondary" @onclick="AddItem">+ Add Item</button>
    </div>

    <!-- Order Items -->
    @if (_items.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Unit Cost</th>
                    <th>Line Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@GetProductName(item.ProductId)</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitCost.ToString("C")</td>
                        <td>@item.LineTotal.ToString("C")</td>
                        <td>
                            <button class="btn-sm danger" @onclick="() => RemoveItem(item)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p><strong>Total: @_items.Sum(i => i.LineTotal).ToString("C")</strong></p>
    }

    <div class="form-actions">
        <button class="btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @(_saving ? "Saving..." : "Save Order")
        </button>
        <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/purchase-orders")'>Cancel</button>
    </div>
</div>

@code {
    private int _supplierId;
    private string _notes = "";
    private string _error = "";
    private bool _saving = false;
    private int _selectedProductId;
    private int _qty = 1;
    private decimal _unitCost;
    private List<Supplier> _suppliers = new();
    private List<Product> _products = new();
    private List<PurchaseOrderItem> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _suppliers = await Db.GetSuppliersAsync();
        _products = await Db.GetProductsAsync();
    }

    private void AddItem()
    {
        _error = "";

        if (_selectedProductId == 0)
        {
            _error = "Please select a product.";
            return;
        }
        if (_qty <= 0)
        {
            _error = "Quantity must be greater than 0.";
            return;
        }
        if (_unitCost <= 0)
        {
            _error = "Unit cost must be greater than 0.";
            return;
        }

        var existing = _items.FirstOrDefault(i => i.ProductId == _selectedProductId);
        if (existing != null)
        {
            existing.Quantity += _qty;
        }
        else
        {
            _items.Add(new PurchaseOrderItem
            {
                ProductId = _selectedProductId,
                Quantity = _qty,
                UnitCost = _unitCost
            });
        }

        _selectedProductId = 0;
        _qty = 1;
        _unitCost = 0;
    }

    private void RemoveItem(PurchaseOrderItem item) => _items.Remove(item);

    private string GetProductName(int id) =>
        _products.FirstOrDefault(p => p.Id == id)?.Name ?? "Unknown";

    private async Task SaveAsync()
    {
        _error = "";

        if (_supplierId == 0)
        {
            _error = "Please select a supplier.";
            return;
        }
        if (!_items.Any())
        {
            _error = "Please add at least one item.";
            return;
        }

        _saving = true;

        var order = new PurchaseOrder
        {
            SupplierId = _supplierId,
            Status = "Pending",
            OrderDate = DateTime.Now,
            Notes = _notes
        };

        await Db.SavePurchaseOrderAsync(order);

        foreach (var item in _items)
        {
            item.OrderId = order.Id;
            await Db.SaveOrderItemAsync(item);
        }

        _saving = false;
        Nav.NavigateTo("/purchase-orders");
    }
}